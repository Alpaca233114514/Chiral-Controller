{
  "name": "chiral-controller",
  "version": "1.0.0",
  "private": true,
  "description": "开罗尔控制器 - Flutter 手机安全远程控制 Kimi Code Desktop",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build:protocol && npm run build:relay",
    "build:protocol": "npm --workspace @chiral/protocol run build",
    "build:relay": "npm --workspace @chiral/relay run build",
    "dev": "npm --workspace @chiral/relay run dev",
    "test": "npm run test:protocol && npm run test:relay",
    "test:protocol": "npm --workspace @chiral/protocol test",
    "test:relay": "npm --workspace @chiral/relay test"
  },
  "keywords": [
    "chiral",
    "controller",
    "kimi",
    "cli",
    "remote",
    "mobile",
    "flutter",
    "relay"
  ],
  "author": "li",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/Chiral-Controller.git"
  }
}
